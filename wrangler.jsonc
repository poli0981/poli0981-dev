{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poli0981-dev",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // Custom entry wrapping the adapter's handler: www→apex, security headers and (later)
  // the Turnstile gate and /media for *every* page, which the Astro middleware never
  // sees for prerendered routes. See src/worker.ts.
  "main": "./src/worker.ts",
  // Serve only via the custom domains — no poli0981-dev.*.workers.dev URL, and no
  // per-version preview URLs either: those live on workers.dev, outside the zone's
  // WAF/Transform/Access rules. Explicit, because an omitted key keeps the old setting.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Pages go through the Worker first; files that must stay reachable without it (and
    // that gain nothing from it) are served straight from the asset layer, which also
    // keeps them unbilled. Globs are anchored and `!` patterns win. /pagefind/* is NOT
    // excluded on purpose: its fragments contain the full text of every page.
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/og/*",
      "!/favicon.svg",
      "!/sw.js",
      "!/skullhop.js",
      "!/gate.js",
      "!/offline*",
      "!/robots.txt",
      "!/sitemap*",
      "!/rss.xml",
      "!/blog/rss.xml",
      "!/truyen/rss.xml",
      "!/.well-known/*",
      // Vite dev-server internals (`astro dev`): the Cloudflare Vite plugin applies these
      // rules before Vite's own middleware, so without them module requests like
      // /@vite/client or /src/styles/global.css reach the Worker and 404, and no island
      // hydrates. None of these paths exist in a build.
      "!/@*",
      "!/src/*",
      "!/node_modules/*",
    ],
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "8c366cd5e57c4dd1b309787d0603c490",
      "preview_id": "7e710034a6a0408191fc00adb5277ae8",
    },
    // Astro's Cloudflare adapter enables sessions by default and injects a `SESSION`
    // KV binding. This site does not use Astro.session, but wrangler deploy needs the
    // binding to resolve to a real namespace — reuse the KV namespace (SESSION keys are
    // never written here, so no collision with rl:/denylist: keys).
    {
      "binding": "SESSION",
      "id": "8c366cd5e57c4dd1b309787d0603c490",
      "preview_id": "7e710034a6a0408191fc00adb5277ae8",
    },
  ],
  // Workers Rate Limiting (docs 06 §2) — replaces the KV read-then-write counter. The
  // period must be 10 or 60 s; counters are per Cloudflare location, so these are
  // per-colo soft limits (the zone WAF rule in docs 07 §6 stays the hard outer limit).
  // namespace_id only has to be unique within the account.
  "ratelimits": [
    { "name": "RL_REPORT", "namespace_id": "981001", "simple": { "limit": 5, "period": 60 } },
    // Generous: one carrier-grade-NAT address can front many phones on VN mobile networks.
    { "name": "RL_GATE", "namespace_id": "981002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_ADMIN", "namespace_id": "981003", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_API", "namespace_id": "981004", "simple": { "limit": 120, "period": 60 } },
  ],
  "vars": {
    // Turnstile gate in front of every page (src/lib/gate): "off" | "on" | "force".
    // "on" fails open while the zone Transform Rule that sets x-verified-bot is missing;
    // "force" ignores that (local testing only). Needs GATE_SECRET + TURNSTILE_SECRET.
    // On since 2026-10-07: the Transform Rule's header was confirmed reaching the Worker
    // (`x-verified-bot: false` for curl and for a spoofed Googlebot UA alike).
    "GATE_MODE": "on",
    // Cloudflare Access application protecting admin.poli0981.dev (src/lib/admin/access).
    // Not secrets: the AUD tag only says which app a token must be minted for.
    "ACCESS_TEAM_DOMAIN": "https://polished-hall-48fd.cloudflareaccess.com",
    "ACCESS_AUD": "197ec8eae1275e465623bdb77f88238b9b01dd66eec0be2e8c13ccd7b13e48b7",
  },
  // Uploaded images (src/lib/media): public AVIF/WebP variants under v1/, private
  // metadata-free masters and per-image metadata elsewhere. The bucket has no public
  // URL — everything public is served by /media in the Worker. Created with
  // `wrangler r2 bucket create poli0981-media --location apac`.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "poli0981-media" }],
  // Cloudflare Images, used only by the admin upload to make the AVIF/WebP variants
  // (never per request). Free tier: 5,000 unique transformations a month. Local in dev
  // (width/height/format only) — never `remote: true`, the build-time prerender worker
  // inherits every binding and CI has no Cloudflare credentials.
  "images": { "binding": "IMAGES" },
  "observability": {
    "enabled": true,
  },
  // routes / custom_domain -> deferred to the deploy plan
}
