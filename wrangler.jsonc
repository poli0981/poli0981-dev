{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poli0981-dev",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // Serve only via the custom domain (poli0981.dev) — no poli0981-dev.*.workers.dev URL.
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "8c366cd5e57c4dd1b309787d0603c490",
      "preview_id": "7e710034a6a0408191fc00adb5277ae8",
    },
    // Astro's Cloudflare adapter enables sessions by default and injects a `SESSION`
    // KV binding. This site does not use Astro.session, but wrangler deploy needs the
    // binding to resolve to a real namespace — reuse the KV namespace (SESSION keys are
    // never written here, so no collision with rl:/denylist: keys).
    {
      "binding": "SESSION",
      "id": "8c366cd5e57c4dd1b309787d0603c490",
      "preview_id": "7e710034a6a0408191fc00adb5277ae8",
    },
  ],
  // Workers Rate Limiting (docs 06 §2) — replaces the KV read-then-write counter. The
  // period must be 10 or 60 s; counters are per Cloudflare location, so these are
  // per-colo soft limits (the zone WAF rule in docs 07 §6 stays the hard outer limit).
  // namespace_id only has to be unique within the account.
  "ratelimits": [
    { "name": "RL_REPORT", "namespace_id": "981001", "simple": { "limit": 5, "period": 60 } },
    // Generous: one carrier-grade-NAT address can front many phones on VN mobile networks.
    { "name": "RL_GATE", "namespace_id": "981002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_ADMIN", "namespace_id": "981003", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_API", "namespace_id": "981004", "simple": { "limit": 120, "period": 60 } },
  ],
  "observability": {
    "enabled": true,
  },
  // routes / custom_domain -> deferred to the deploy plan
}
