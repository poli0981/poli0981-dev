{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poli0981-dev",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "8c366cd5e57c4dd1b309787d0603c490",
      "preview_id": "7e710034a6a0408191fc00adb5277ae8",
    },
  ],
  "observability": {
    "enabled": true,
  },
  // routes / custom_domain -> deferred to the deploy plan
}
