# Supply-chain hardening (docs 06 §6). npm >= 11 resolves lifecycle scripts against
# package.json#allowScripts; `strict-allow-scripts` turns "package X has an install
# script you haven't reviewed" from a warning into a failed install. A dependency that
# suddenly grows a postinstall — the Shai-Hulud worm shape — stops the build instead of
# executing. Review it, then `npm approve-scripts <pkg>` to add it to the allowlist.
#
# The previous note here claimed CI applied `ignore-scripts` and that `sharp` needed
# scripts. Both were wrong: CI never set it, and sharp@0.35 ships prebuilt @img/sharp-*
# binaries with no install script at all.
fund=false
strict-allow-scripts=true
