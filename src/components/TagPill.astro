---
import { sectionPath, type Locale } from "../i18n/routing";

interface Props {
  tag: string;
  locale: Locale;
  count?: number;
  /** When false, render a plain chip instead of a link to the tag page. */
  link?: boolean;
}
const { tag, locale, count, link = true } = Astro.props;
const href = sectionPath("blog", locale, "tag", tag);
const Tag = link ? "a" : "span";
---

<Tag class="tag-pill" href={link ? href : undefined}>
  #{tag}{count != null && <span class="tag-count">{count}</span>}
</Tag>

<style>
  .tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.2em 0.6em;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--muted);
    font-family: var(--ff-mono);
    font-size: var(--text-meta);
    line-height: 1.4;
    transition:
      color var(--duration-fast) var(--ease-site),
      border-color var(--duration-fast) var(--ease-site);
  }
  a.tag-pill:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .tag-count {
    color: var(--text);
    opacity: 0.7;
  }
</style>
