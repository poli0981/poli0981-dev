---
// Styles live in src/styles/prose.css, not in a <style> block here: Callout is only ever
// rendered from MDX content, and Astro does not hash the styles of such components into the
// page's CSP — the browser dropped them (scripts/check-csp-hashes.mjs now checks styles too).
interface Props {
  type?: "info" | "tip" | "warn";
  title?: string;
}
const { type = "info", title } = Astro.props;
const icon = { info: "i", tip: "★", warn: "!" }[type];
---

<aside class:list={["callout", type]} role="note">
  <span class="callout-icon" aria-hidden="true">{icon}</span>
  <div class="callout-body">
    {title && <p class="callout-title">{title}</p>}
    <slot />
  </div>
</aside>
