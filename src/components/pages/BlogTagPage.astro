---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostGrid from "@/components/PostGrid.astro";
import { useTranslations } from "@/i18n";
import { sectionPath, type Locale } from "@/i18n/routing";
import type { BlogEntry } from "@/lib/collections";

interface Props {
  locale: Locale;
  tag: string;
  posts: BlogEntry[];
}
const { tag, posts, locale } = Astro.props as Props;
const t = useTranslations(locale);
---

{/* Tags are per-locale (a vi tag has no guaranteed en page) → no hreflang. */}
<BaseLayout title={`#${tag}`} {locale} alternates={null}>
  <section class="page py-section">
    <nav class="crumb" aria-label={t.landmarks.breadcrumb}>
      <a href={sectionPath("blog", locale)}>{t.nav.blog}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">#{tag}</span>
    </nav>
    <h1 class="text-h1">#{tag}</h1>
    <div class="grid-wrap"><PostGrid {posts} {locale} headingLevel={2} /></div>
  </section>
</BaseLayout>

<style>
  /* A flex row with a gap: the build strips the whitespace between the link, the slash
     and the current page, so the spacing cannot come from the markup. */
  .crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--muted);
    font-family: var(--ff-mono);
    font-size: var(--text-meta);
  }
  .crumb a:hover {
    color: var(--accent);
  }
  .grid-wrap {
    margin-block-start: 2rem;
  }
</style>
