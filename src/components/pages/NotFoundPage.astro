---
// The 404 page for one locale: 404.astro (vi) and en/404.astro. The asset layer serves the
// nearest 404.html up a missing path, so /en/... misses get the English one (astro.config.mjs
// moves it to en/404.html; src/worker.ts returns that response as is).
import ErrorLayout from "@/layouts/ErrorLayout.astro";
import { getLatestMixed } from "@/lib/collections";
import { useTranslations } from "@/i18n";
import { DEFAULT_LOCALE, sectionPath, type Locale } from "@/i18n/routing";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
// The heading again in a second language — English, or the default one on the English page.
const echo: Locale = locale === "en" ? DEFAULT_LOCALE : "en";

const latest = await getLatestMixed(locale, 3);
const linkFor = (item: (typeof latest)[number]) =>
  item.kind === "blog"
    ? sectionPath("blog", locale, item.entry.id)
    : sectionPath("stories", locale, ...item.entry.id.split("/"));
---

<ErrorLayout title="404 — poli0981.dev" {locale} showReport>
  <p class="code">404</p>
  <h1>{t.notFound.heading}</h1>
  <p class="echo" lang={echo}>{useTranslations(echo).notFound.heading}</p>

  <form id="s404-form" class="s404" role="search">
    <input
      id="s404-input"
      type="search"
      placeholder={t.notFound.search}
      aria-label={t.search.aria}
      autocomplete="off"
      spellcheck="false"
    />
  </form>
  <ul id="s404-results" class="s404-results" aria-live="polite"></ul>

  {
    latest.length > 0 && (
      <ul class="recent">
        {latest.map((item) => (
          <li>
            <a href={linkFor(item)}>{item.entry.data.title}</a>
          </li>
        ))}
      </ul>
    )
  }
</ErrorLayout>

<script>
  // Lightweight inline search — lazy-loads the Pagefind runtime on first input.
  // Degrades silently where the index is absent (e.g. `astro dev`).
  const form = document.getElementById("s404-form");
  const input = document.getElementById("s404-input");
  const list = document.getElementById("s404-results");
  if (form && input instanceof HTMLInputElement && list) {
    form.addEventListener("submit", (e) => e.preventDefault());
    type PagefindApi = {
      search: (q: string) => Promise<{ results: { data: () => Promise<unknown> }[] }>;
    };
    let pf: PagefindApi | null = null;
    let timer: ReturnType<typeof setTimeout>;
    const load = async (): Promise<PagefindApi> => {
      if (pf) return pf;
      const mod = (await import(
        new URL("/pagefind/pagefind.js", location.origin).href
      )) as PagefindApi;
      pf = mod;
      return mod;
    };
    input.addEventListener("input", () => {
      clearTimeout(timer);
      const q = input.value.trim();
      if (!q) {
        list.replaceChildren();
        return;
      }
      timer = setTimeout(async () => {
        try {
          const api = await load();
          const search = await api.search(q);
          const items = await Promise.all(search.results.slice(0, 5).map((r) => r.data()));
          list.replaceChildren(
            ...items.map((d) => {
              const data = d as { url: string; meta?: { title?: string } };
              const li = document.createElement("li");
              const a = document.createElement("a");
              a.href = data.url;
              a.textContent = data.meta?.title ?? data.url;
              li.appendChild(a);
              return li;
            }),
          );
        } catch {
          /* index unavailable — leave results empty */
        }
      }, 200);
    });
  }
</script>

<style>
  .s404 {
    margin-block-start: 0.5rem;
    inline-size: min(28rem, 90vw);
  }
  .s404 input {
    inline-size: 100%;
    padding: 0.7rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }
  .s404 input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .s404-results {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    inline-size: min(28rem, 90vw);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-align: start;
  }
  .s404-results a {
    color: var(--accent);
    font-size: var(--text-meta);
  }
  .s404-results a:hover {
    color: var(--accent-strong);
  }
  .recent {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .recent a {
    color: var(--text);
  }
  .recent a:hover {
    color: var(--accent);
  }
</style>
