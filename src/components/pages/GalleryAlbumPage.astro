---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Lightbox from "@/components/Lightbox.svelte";
import { getImage } from "astro:assets";
import GalleryGrid from "@/components/GalleryGrid.astro";
import { mediaSrcset, mediaUrl, variantWidths } from "@/lib/media";
import type { GalleryEntry } from "@/lib/collections";
import type { GalleryPhoto } from "@/lib/gallery";
import { sectionPath, type Locale } from "@/i18n/routing";
import { useTranslations } from "@/i18n";
import { formatDate } from "@/lib/format";
import ContentNotice from "@/components/ContentNotice.astro";
import AgeGate from "@/components/AgeGate.astro";
import { labelNames, needsBlur } from "@/lib/content-labels";

interface Props {
  locale: Locale;
  entry: GalleryEntry;
  photos: GalleryPhoto[];
}
const { entry, photos, locale } = Astro.props as Props;
const t = useTranslations(locale);

// Labels: the album's own blur every photo; a photo's own blur just that one. The notice
// lists both, and its "Hiện ảnh" box un-blurs the page's photos and the viewer's slides.
const albumLabels = entry.data.contentWarning;
const albumBlur = needsBlur(albumLabels);
const allLabels = [...new Set([...albumLabels, ...photos.flatMap((p) => p.labels)])];
const photoBlur = photos.map((p) => albumBlur || needsBlur(p.labels));
const anyPhotoBlur = !albumBlur && photoBlur.some(Boolean);
const warningOf = (p: GalleryPhoto) => {
  const names = labelNames([...new Set([...albumLabels, ...p.labels])], t.labels);
  return names.length ? t.cw.photo.replace("{labels}", names.join(", ")) : "";
};

// Full-size AVIF slides for the lightbox island (plain <img> with /_astro URLs → CSP-safe).
const slides = await Promise.all(
  photos.map(async (p) => {
    if (p.kind === "media") {
      // R2 photo: the WebP variants (AVIF can't go in a plain <img srcset> safely).
      const widths = variantWidths("webp", p.media.w);
      return {
        src: mediaUrl(p.media.id, "webp", widths[widths.length - 1]),
        srcset: mediaSrcset(p.media, "webp"),
        width: p.media.w,
        height: p.media.h,
        alt: p.alt[locale],
        blur: albumBlur || needsBlur(p.labels),
        warning: warningOf(p),
      };
    }
    const full = await getImage({
      src: p.image,
      widths: [640, 1024, 1600, 2000],
      sizes: "92vw",
      format: "avif",
    });
    return {
      src: full.src,
      srcset: full.srcSet.attribute,
      width: p.image.width,
      height: p.image.height,
      alt: p.alt[locale],
      blur: albumBlur || needsBlur(p.labels),
      warning: warningOf(p),
    };
  }),
);
const hrefs = slides.map((slide) => slide.src);
const ownBlur = photoBlur.map((blurred) => blurred && !albumBlur);
const thumbLabels = photos.map((p) =>
  [t.gallery.open, p.alt[locale], warningOf(p)].filter(Boolean).join(" — "),
);
---

<BaseLayout title={entry.data.title} description={entry.data.description} {locale}>
  <section
    class="page py-section"
    data-cw-blur={albumBlur ? "" : undefined}
    data-cw-scope={anyPhotoBlur ? "" : undefined}
  >
    <nav class="crumb" aria-label={t.landmarks.breadcrumb}>
      <a href={sectionPath("gallery", locale)}>{t.nav.gallery}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{entry.data.title}</span>
    </nav>
    <h1 class="text-h1">{entry.data.title}</h1>
    {entry.data.description && <p class="lead">{entry.data.description}</p>}
    <p class="date">{formatDate(entry.data.date, locale)}</p>

    <ContentNotice labels={allLabels} ageRating={entry.data.ageRating} {locale} />

    {
      entry.data.ageRating ? (
        <AgeGate rating={entry.data.ageRating} {locale}>
          <GalleryGrid {photos} {hrefs} blurred={ownBlur} labels={thumbLabels} {locale} />
        </AgeGate>
      ) : (
        <GalleryGrid {photos} {hrefs} blurred={ownBlur} labels={thumbLabels} {locale} />
      )
    }

    <Lightbox client:idle {slides} labels={{ ...t.gallery, reveal: t.cw.reveal }} />
  </section>
</BaseLayout>

<style>
  /* A flex row with a gap: the build strips the whitespace between the link, the slash
     and the current page, so the spacing cannot come from the markup. */
  .crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--muted);
    font-family: var(--ff-mono);
    font-size: var(--text-meta);
  }
  .crumb a:hover {
    color: var(--accent);
  }
  .lead {
    margin-block-start: 0.5rem;
    color: var(--muted);
    font-size: var(--text-lead);
  }
  .date {
    margin-block-start: 0.5rem;
    color: var(--muted);
    font-family: var(--ff-mono);
    font-size: var(--text-meta);
  }
</style>
