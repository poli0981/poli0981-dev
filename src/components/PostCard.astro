---
import { Image } from "astro:assets";
import { type BlogEntry, readingTime } from "../lib/collections";
import { sectionPath, type Locale } from "../i18n/routing";
import { useTranslations } from "../i18n";
import { formatDate, isoDate } from "../lib/format";

interface Props {
  entry: BlogEntry;
  locale: Locale;
}
const { entry, locale } = Astro.props;
const t = useTranslations(locale);
const href = sectionPath("blog", locale, entry.id);
const mins = readingTime(entry.body);
---

<article class="card">
  <a class="card-link" href={href}>
    {
      entry.data.cover && (
        <div class="card-cover">
          <Image
            src={entry.data.cover}
            alt=""
            widths={[400, 800]}
            sizes="(max-width: 768px) 100vw, 380px"
            loading="lazy"
          />
        </div>
      )
    }
    <div class="card-body">
      <h3 class="card-title">{entry.data.title}</h3>
      <p class="card-desc">{entry.data.description}</p>
      <div class="card-meta">
        <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date, locale)}</time>
        <span class="dot" aria-hidden="true">·</span>
        <span>{mins} {t.post.minRead}</span>
      </div>
    </div>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    overflow: clip;
    transition:
      transform var(--duration-fast) var(--ease-site),
      border-color var(--duration-fast) var(--ease-site);
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
  }
  .card-link {
    display: block;
    block-size: 100%;
    color: inherit;
  }
  .card-cover :global(img) {
    display: block;
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .card-body {
    padding: 1rem 1.1rem 1.15rem;
  }
  .card-title {
    font-size: var(--text-lead);
    font-weight: 700;
    line-height: 1.25;
  }
  .card-desc {
    margin-block-start: 0.4rem;
    color: var(--muted);
    font-size: var(--text-body);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-meta {
    margin-block-start: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-family: var(--ff-mono);
    font-size: var(--text-meta);
  }
</style>
