---
import "../styles/prose.css";

interface Props {
  class?: string;
  /** Reader mode widens the measure and uses the reading font at a larger size. */
  reader?: boolean;
}
const { class: className = "", reader = false } = Astro.props;
---

<div class:list={["prose", { "prose--reader": reader }, className]}>
  <slot />
</div>
