---
import { Image } from "astro:assets";
import MediaImage from "./MediaImage.astro";
import { albumWarning, type GalleryEntry } from "../lib/collections";
import type { GalleryPhoto } from "../lib/gallery";
import { sectionPath, type Locale } from "../i18n/routing";
import { useTranslations } from "../i18n";
import { labelNames, needsBlur } from "../lib/content-labels";

interface Props {
  entry: GalleryEntry;
  cover: GalleryPhoto;
  locale: Locale;
  /** Heading level of the card title: 3 under a section heading, 2 right under the
      page's h1 (an index page) — heading levels must not skip. */
  headingLevel?: 2 | 3;
}
const { entry, cover, locale, headingLevel = 3 } = Astro.props;
const Title = `h${headingLevel}` as const;
const href = sectionPath("gallery", locale, entry.data.album);
const year = entry.data.date.getFullYear();
// The cover stays blurred when the album (in either language) or that photo carries a label
// that blurs images, or when the album is age-rated; the card says why.
const t = useTranslations(locale);
const { labels: albumLabels, ageRating } = await albumWarning(entry.data.album);
const labels = [...new Set([...albumLabels, ...cover.labels])];
const blurCover = needsBlur(labels) || Boolean(ageRating);
const warning = [...labelNames(labels, t.labels), ...(ageRating ? [ageRating] : [])].join(" · ");
---

<article class="card">
  <a class="card-link" href={href}>
    <div class="cover" data-cw-blur={blurCover ? "" : undefined}>
      {
        cover.kind === "local" ? (
          <Image
            src={cover.image}
            alt=""
            widths={[400, 800]}
            sizes="(max-width: 640px) 100vw, 360px"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <MediaImage media={cover.media} alt="" sizes="(max-width: 640px) 100vw, 360px" />
        )
      }
    </div>
    <div class="body">
      <Title class="title">{entry.data.title}</Title>
      <span class="year">{year}</span>
      {
        warning && (
          <span class="cw">
            <span aria-hidden="true">⚠</span>
            <span class="sr-only">{t.cw.title}:</span>
            {warning}
          </span>
        )
      }
    </div>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    overflow: clip;
    transition:
      transform var(--duration-fast) var(--ease-site),
      border-color var(--duration-fast) var(--ease-site);
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
  }
  .card-link {
    display: block;
    color: inherit;
  }
  .cover :global(img) {
    display: block;
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .body {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 0.75rem;
    padding: 0.9rem 1.1rem 1rem;
  }
  /* Its own line under the title; the gap stands in for the whitespace the build strips. */
  .cw {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35em;
    flex-basis: 100%;
    color: color-mix(in srgb, var(--horror) 35%, var(--text));
    font-family: var(--ff-mono);
    font-size: var(--text-meta);
  }
  .title {
    font-size: var(--text-lead);
    font-weight: 700;
    line-height: 1.25;
  }
  .year {
    color: var(--muted);
    font-family: var(--ff-mono);
    font-size: var(--text-meta);
  }
</style>
