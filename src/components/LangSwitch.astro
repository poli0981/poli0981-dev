---
import { alternatePath, localeFromPath, type Locale } from "../i18n/routing";
import { useTranslations } from "../i18n";

interface Props {
  /** Override the target url (content pages resolve this from translationKey). */
  href?: string;
  label?: string;
}

const current: Locale = localeFromPath(Astro.url.pathname);
const target: Locale = current === "vi" ? "en" : "vi";
const t = useTranslations(current);

const { href = alternatePath(Astro.url.pathname, target), label = t.lang.switchTo } = Astro.props;
const code = target.toUpperCase();
---

{
  /* The accessible name must CONTAIN the visible text ("English" / "Tiếng Việt") so
     voice control can act on what the user sees — WCAG 2.5.3 Label in Name (A).
     `aria-label="Ngôn ngữ"` alone dropped it entirely. */
}
{
  /* On a narrow phone the full name does not fit next to the brand and the three buttons
     (the header needs 378px with "English", 400px with "Tiếng Việt"), and the page then
     scrolled sideways. Below those widths the link shows the language code instead. The
     accessible name carries both the name and the code as words of their own
     ("Tiếng Việt, VI — Language"), so it contains whichever of the two is on screen. axe
     matches whole words and drops anything in parentheses: "VI" inside "Việt" does not
     count, and neither would "(VI)". */
}
<a
  class:list={["lang-switch", `to-${target}`]}
  {href}
  hreflang={target}
  lang={target}
  aria-label={`${label}, ${code} — ${t.lang.label}`}
>
  <span class="full">{label}</span>
  <span class="short" aria-hidden="true">{code}</span>
</a>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    block-size: 2.5rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-control);
    border: 1px solid transparent;
    color: var(--muted);
    font-size: var(--text-meta);
    font-weight: 500;
    white-space: nowrap;
    transition:
      color var(--duration-fast) var(--ease-site),
      background var(--duration-fast) var(--ease-site),
      border-color var(--duration-fast) var(--ease-site);
  }
  .lang-switch:hover {
    color: var(--text);
    background: var(--surface);
    border-color: var(--line);
  }
  .short {
    display: none;
  }
  /* rem, so the switch-over moves with the reader's font size like the text it measures. */
  @media (max-width: 23.99rem) {
    .to-en .full {
      display: none;
    }
    .to-en .short {
      display: inline;
    }
  }
  @media (max-width: 25.24rem) {
    .to-vi .full {
      display: none;
    }
    .to-vi .short {
      display: inline;
    }
  }
</style>
