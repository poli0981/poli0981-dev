---
import { toLocale, useTranslations } from "../i18n";
import { homePath, type Locale } from "../i18n/routing";
import { primaryNav, isActivePath } from "../lib/nav";
import ThemeToggle from "./ThemeToggle.svelte";
import LangSwitch from "./LangSwitch.astro";

const locale: Locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const nav = primaryNav(locale);
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="page header-inner">
    <a class="brand" href={homePath(locale)} aria-label="poli0981.dev — home">
      <svg class="brand-mark" viewBox="0 0 32 12" aria-hidden="true">
        <path
          d="M1 6 H8 L10 2 L13 10 L16 3 L19 9 L22 6 H31"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="brand-text">SkullMute</span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isActivePath(pathname, item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <ThemeToggle client:load label={t.theme.toggle} />
      <LangSwitch />
      <button
        type="button"
        class="menu-trigger"
        data-menu-trigger
        aria-label={t.nav.openMenu}
        aria-controls="menu-sheet"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
          <path
            d="M3 6h18M3 12h18M3 18h18"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-block-end: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    block-size: 3.75rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    font-family: var(--ff-display);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .brand-mark {
    inline-size: 2rem;
    block-size: 0.75rem;
    color: var(--accent);
  }
  .primary-nav {
    display: none;
    gap: 0.35rem;
    margin-inline-start: auto;
  }
  .primary-nav a {
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-control);
    color: var(--muted);
    font-size: var(--text-meta);
    font-weight: 500;
    transition:
      color var(--duration-fast) var(--ease-site),
      background var(--duration-fast) var(--ease-site);
  }
  .primary-nav a:hover {
    color: var(--text);
    background: var(--surface);
  }
  .primary-nav a[aria-current="page"] {
    color: var(--accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-inline-start: auto;
  }
  .menu-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: var(--radius-control);
    border: 1px solid transparent;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .menu-trigger:hover {
    background: var(--surface);
    border-color: var(--line);
  }

  @media (min-width: 768px) {
    .primary-nav {
      display: flex;
    }
    /* On desktop the primary nav takes the middle; actions sit at the end. */
    .actions {
      margin-inline-start: 0;
    }
    .menu-trigger {
      display: none;
    }
  }
</style>
