---
import { toLocale, useTranslations } from "../i18n";
import { homePath, type Locale } from "../i18n/routing";
import { primaryNav, isActivePath } from "../lib/nav";
import ThemeToggle from "./ThemeToggle.svelte";
import LangSwitch from "./LangSwitch.astro";

interface Props {
  /** Target of the language switch (BaseLayout resolves translations and fallbacks). */
  langHref?: string;
}
const { langHref } = Astro.props;
const locale: Locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const nav = primaryNav(locale);
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="page header-inner">
    {
      /* The accessible name must START with the visible text ("SkullMute"), or voice
         control cannot act on what the user can see — WCAG 2.5.3 Label in Name (A).
         Caught by Lighthouse's label-content-name-mismatch. */
    }
    <a class="brand" href={homePath(locale)} aria-label={`SkullMute — poli0981.dev`}>
      <svg class="brand-mark" viewBox="0 0 32 12" aria-hidden="true">
        <path
          d="M1 6 H8 L10 2 L13 10 L16 3 L19 9 L22 6 H31"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="brand-text">SkullMute</span>
    </a>

    <nav class="primary-nav" aria-label={t.landmarks.primary}>
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isActivePath(pathname, item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <button
        type="button"
        class="search-trigger"
        data-search-trigger
        aria-label={t.search.trigger}
        aria-controls="search-modal"
        aria-expanded="false"
        aria-keyshortcuts="/"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.7"></circle>
          <path d="M20 20l-3.2-3.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
          ></path>
        </svg>
      </button>
      {
        /* idle, not load: CSS already shows the right icon from <html data-theme-pref>, so
          the Svelte runtime need not compete with first paint for bandwidth. */
      }
      <ThemeToggle client:idle labels={t.theme} />
      <LangSwitch href={langHref} />
      <button
        type="button"
        class="menu-trigger"
        data-menu-trigger
        aria-label={t.nav.openMenu}
        aria-controls="menu-sheet"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
          <path
            d="M3 6h18M3 12h18M3 18h18"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 40;
    /* Opaque and without backdrop-filter: Safari 26 extends a sticky header's background
       up under the iPhone status bar, but gives up when the header has a backdrop-filter —
       the page then scrolled into view above the header. */
    background: var(--bg);
    border-block-end: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    block-size: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    font-family: var(--ff-display);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .brand-mark {
    inline-size: 2rem;
    block-size: 0.75rem;
    color: var(--accent);
  }
  .primary-nav {
    display: none;
    gap: 0.35rem;
    margin-inline-start: auto;
  }
  .primary-nav a {
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-control);
    color: var(--muted);
    font-size: var(--text-meta);
    font-weight: 500;
    transition:
      color var(--duration-fast) var(--ease-site),
      background var(--duration-fast) var(--ease-site);
  }
  .primary-nav a:hover {
    color: var(--text);
    background: var(--surface);
  }
  .primary-nav a[aria-current="page"] {
    color: var(--accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-inline-start: auto;
  }
  .menu-trigger,
  .search-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: var(--radius-control);
    border: 1px solid transparent;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .menu-trigger:hover,
  .search-trigger:hover {
    background: var(--surface);
    border-color: var(--line);
  }

  /* The full nav needs ~900px in English (seven links plus the actions): below 960px
     tablets keep the menu button rather than overflowing the header. */
  @media (min-width: 60rem) {
    .primary-nav {
      display: flex;
    }
    /* On desktop the primary nav takes the middle; actions sit at the end. */
    .actions {
      margin-inline-start: 0;
    }
    .menu-trigger {
      display: none;
    }
  }
</style>
