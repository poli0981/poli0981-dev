---
interface NavLink {
  href: string;
  label: string;
}
interface Props {
  prev?: NavLink | null;
  next?: NavLink | null;
  prevText?: string;
  nextText?: string;
  ariaLabel?: string;
}
const {
  prev = null,
  next = null,
  prevText = "Trước",
  nextText = "Sau",
  ariaLabel = "Pagination",
} = Astro.props;
---

<nav class="pager" aria-label={ariaLabel}>
  {
    prev ? (
      <a class="pager-link prev" href={prev.href} rel="prev">
        <span class="dir">← {prevText}</span>
        <span class="lbl">{prev.label}</span>
      </a>
    ) : (
      <span class="pager-empty" />
    )
  }
  {
    next ? (
      <a class="pager-link next" href={next.href} rel="next">
        <span class="dir">{nextText} →</span>
        <span class="lbl">{next.label}</span>
      </a>
    ) : (
      <span class="pager-empty" />
    )
  }
</nav>

<style>
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--text);
    transition:
      border-color var(--duration-fast) var(--ease-site),
      transform var(--duration-fast) var(--ease-site);
  }
  .pager-link:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
    transform: translateY(-2px);
  }
  .pager-link.next {
    text-align: end;
  }
  .dir {
    color: var(--accent);
    font-family: var(--ff-mono);
    font-size: var(--text-meta);
  }
  .lbl {
    font-weight: 600;
    font-size: var(--text-body);
    line-height: 1.3;
  }
</style>
