---
import ErrorLayout from "@/layouts/ErrorLayout.astro";
import { emailForScope } from "@/lib/links";

const contact = emailForScope("general");
---

<ErrorLayout title="403 — poli0981.dev">
  <p class="code">403</p>
  <h1>Cửa này đang khoá.</h1>
  <p class="echo" lang="en">This door is locked.</p>
  <p class="code">
    Nếu bạn nghĩ đây là nhầm lẫn / If this looks wrong —
    <a href={contact.href}>{contact.address}</a>
  </p>
</ErrorLayout>
