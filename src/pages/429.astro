---
import ErrorLayout from "@/layouts/ErrorLayout.astro";
---

<ErrorLayout title="429 — poli0981.dev" showLinks={false}>
  <p class="code">429</p>
  <h1>Chậm lại một nhịp.</h1>
  <p class="echo" lang="en">Take a breath.</p>
  {/* 60 s = the /api groups' window; the Worker rewrites it for the site-wide limit (10 s). */}
  <p class="code">Thử lại sau / Retry in <span id="cd">60</span>s</p>
  {
    /* Processed (not `is:inline`): body-level, so the <meta> CSP governs it and only a
      bundled script gets a hash. Deferring costs nothing for a 1s-tick countdown. */
  }
  <script>
    const el = document.getElementById("cd");
    let n = Number(el?.textContent) || 60;
    const t = setInterval(() => {
      n -= 1;
      if (el) el.textContent = String(n);
      if (n <= 0) clearInterval(t);
    }, 1000);
  </script>
</ErrorLayout>
