---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Lightbox from "@/components/Lightbox.svelte";
import { Image, getImage } from "astro:assets";
import { galleryAlbumPaths } from "@/lib/pages";
import type { GalleryEntry } from "@/lib/collections";
import type { GalleryPhoto } from "@/lib/gallery";
import { sectionPath } from "@/i18n/routing";
import { useTranslations } from "@/i18n";
import { formatDate } from "@/lib/format";

export const getStaticPaths = () => galleryAlbumPaths("en");

interface Props {
  entry: GalleryEntry;
  photos: GalleryPhoto[];
}
const { entry, photos } = Astro.props as Props;
const locale = "en" as const;
const t = useTranslations(locale);

const slides = await Promise.all(
  photos.map(async (p) => {
    const full = await getImage({
      src: p.image,
      widths: [640, 1024, 1600, 2000],
      sizes: "92vw",
      format: "avif",
    });
    return {
      src: full.src,
      srcset: full.srcSet.attribute,
      width: p.image.width,
      height: p.image.height,
      alt: p.alt[locale],
    };
  }),
);
---

<BaseLayout title={entry.data.title} description={entry.data.description} {locale}>
  <section class="page py-section">
    <p class="crumb">
      <a href={sectionPath("gallery", locale)}>{t.nav.gallery}</a> / {entry.data.title}
    </p>
    <h1 class="text-h1">{entry.data.title}</h1>
    {entry.data.description && <p class="lead">{entry.data.description}</p>}
    <p class="date">{formatDate(entry.data.date, locale)}</p>

    <div class="photo-grid">
      {
        photos.map((p, i) => (
          <button
            type="button"
            class="thumb"
            data-lightbox-index={i}
            aria-label={`${t.gallery.open} — ${p.alt[locale]}`}
          >
            <Image
              src={p.image}
              alt=""
              widths={[400, 800]}
              sizes="(max-width: 640px) 50vw, 320px"
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
              {...(i === 0 ? { fetchpriority: "high" as const } : {})}
            />
          </button>
        ))
      }
    </div>

    <Lightbox client:idle {slides} labels={t.gallery} />
  </section>
</BaseLayout>

<style>
  .crumb {
    color: var(--muted);
    font-family: var(--ff-mono);
    font-size: var(--text-meta);
  }
  .crumb a:hover {
    color: var(--accent);
  }
  .lead {
    margin-block-start: 0.5rem;
    color: var(--muted);
    font-size: var(--text-lead);
  }
  .date {
    margin-block-start: 0.5rem;
    color: var(--muted);
    font-family: var(--ff-mono);
    font-size: var(--text-meta);
  }
  .photo-grid {
    margin-block-start: 1.5rem;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 640px) {
    .photo-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 960px) {
    .photo-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .thumb {
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    overflow: clip;
    cursor: pointer;
    aspect-ratio: 1 / 1;
    transition:
      transform var(--duration-fast) var(--ease-site),
      border-color var(--duration-fast) var(--ease-site);
  }
  .thumb:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
  }
  .thumb :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
</style>
