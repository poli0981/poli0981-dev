---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostGrid from "@/components/PostGrid.astro";
import TagPill from "@/components/TagPill.astro";
import Waveline from "@/components/Waveline.svelte";
import { getBlogPosts, collectTags } from "@/lib/collections";
import { useTranslations } from "@/i18n";
import { sectionPath } from "@/i18n/routing";

const locale = "en" as const;
const t = useTranslations(locale);
const posts = await getBlogPosts(locale);
const tags = collectTags(posts);
---

<BaseLayout title={t.nav.blog} {locale}>
  <section class="page py-section">
    <h1 class="text-h1">{t.nav.blog}</h1>
    <div class="wave"><Waveline client:visible height={28} /></div>
    {
      tags.length > 0 && (
        <div class="tag-cloud">
          {tags.map(({ tag, count }) => (
            <TagPill {tag} {locale} {count} />
          ))}
        </div>
      )
    }
    <PostGrid
      {posts}
      {locale}
      emptyText={t.post.onlyVi}
      emptyHref={sectionPath("blog", "vi")}
      emptyLabel="Blog (tiếng Việt)"
    />
  </section>
</BaseLayout>

<style>
  .wave {
    margin-block: 1rem 1.5rem;
    max-inline-size: 22rem;
  }
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-end: 2rem;
  }
</style>
