---
import ErrorLayout from "@/layouts/ErrorLayout.astro";
---

<ErrorLayout title="500 — poli0981.dev" showReport>
  <p class="code">500</p>
  <h1>Có gì đó vỡ trong im lặng.</h1>
  <p class="echo" lang="en">Something broke, quietly.</p>
  {/* The Worker stamps the Cloudflare Ray ID into #ref (src/lib/error-ref.ts). */}
  <p class="code">
    Mã tham chiếu / Reference: <span class="ref" id="ref">—</span>
  </p>
</ErrorLayout>
