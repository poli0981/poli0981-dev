---
import ErrorLayout from "@/layouts/ErrorLayout.astro";
---

<ErrorLayout title="500 — poli0981.dev" showReport>
  <p class="code">500</p>
  <h1>Có gì đó vỡ trong im lặng.</h1>
  <p class="en">Something broke, quietly.</p>
  <p class="code">
    Mã tham chiếu / Reference: <span class="ref" id="ref">…</span>
  </p>
  {
    /* Processed (not `is:inline`): this sits in the body, so a <meta> CSP already governs
      it, and only a bundled script gets a hash. Deferring is fine — it only fills a span. */
  }
  <script>
    const el = document.getElementById("ref");
    if (el) el.textContent = crypto.randomUUID().slice(0, 8);
  </script>
</ErrorLayout>
