---
import "../styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import SkipLink from "../components/SkipLink.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileTabBar from "../components/MobileTabBar.astro";
import MenuSheet from "../components/MenuSheet.svelte";
import SearchModal from "../components/SearchModal.svelte";
import LegalGateSheet from "../components/LegalGateSheet.svelte";
import ReportDialog from "../components/ReportDialog.astro";
import { resolveSeo, SITE, hreflangPair, personSchema, type SeoInput } from "../lib/seo";
import { toLocale, useTranslations } from "../i18n";
import { menuNav, legalNav } from "../lib/nav";

interface Props extends SeoInput {
  /** Extra classes for the <main> wrapper. */
  mainClass?: string;
  /** Reading pages (blog post, story chapter) load the Literata reading font. */
  reading?: boolean;
  /**
   * hreflang alternates. `undefined` → auto (vi↔en pair for bilingual pages);
   * `null` → suppress (single-locale pages, e.g. tag pages); object → explicit pair.
   */
  alternates?: { vi?: string; en?: string } | null;
  /** Page-specific JSON-LD (BlogPosting / CreativeWork / SoftwareSourceCode). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { mainClass, reading = false, alternates, jsonLd, ...seoInput } = Astro.props;
// Default the locale from the URL (Astro.currentLocale) so /en/* pages resolve to `en`.
const locale = seoInput.locale ?? toLocale(Astro.currentLocale);
const seo = resolveSeo({ ...seoInput, locale }, Astro.url.pathname);
const lang = seo.locale;
const t = useTranslations(lang);
const ogImage = seo.image ? new URL(seo.image, SITE.url).href : undefined;

// hreflang: default to the auto vi↔en pair unless the page opts out (null) or overrides.
// Normalize to the trailing-slash form so hreflang URLs match canonicals exactly.
const withSlash = (p: string): string =>
  p.endsWith("/") || (p.split("/").pop() ?? "").includes(".") ? p : `${p}/`;
const autoAlt = alternates === undefined ? hreflangPair(Astro.url.pathname) : alternates;
const alt =
  autoAlt?.vi && autoAlt.en ? { vi: withSlash(autoAlt.vi), en: withSlash(autoAlt.en) } : null;
const menuItems = menuNav(lang);
const legalItems = legalNav(lang);
// The legal-notice gate is a reminder layer — never shown on the legal pages themselves.
const onLegalPage = /\/legal(\/|$)/.test(Astro.url.pathname);
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Apply stored theme before first paint, and re-apply after View Transitions swaps. */}
    <script is:inline>
      (() => {
        const apply = () => {
          try {
            const t = localStorage.getItem("theme");
            if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
          } catch {}
        };
        apply();
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* hreflang — only for pages that exist in both locales (x-default → vi). */}
    {
      alt && (
        <Fragment>
          <link rel="alternate" hreflang="vi" href={new URL(alt.vi, SITE.url).href} />
          <link rel="alternate" hreflang="en" href={new URL(alt.en, SITE.url).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(alt.vi, SITE.url).href} />
        </Fragment>
      )
    }

    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — RSS`} href="/rss.xml" />

    <meta name="theme-color" content={SITE.themeColor.dark} media="(prefers-color-scheme: dark)" />
    <meta
      name="theme-color"
      content={SITE.themeColor.light}
      media="(prefers-color-scheme: light)"
    />

    {/* Open Graph / Twitter */}
    <meta property="og:type" content={seo.type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:locale" content={lang === "vi" ? "vi_VN" : "en_US"} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      /* Self-hosted fonts. Preload only the display family (hero + headings, the most
        prominent first-paint text). Body/mono swap in with size-adjusted fallbacks
        (optimizedFallbacks → CLS-safe), keeping the preload set within the perf budget. */
    }
    <Font cssVariable="--ff-display" preload />
    <Font cssVariable="--ff-body" />
    <Font cssVariable="--ff-mono" />
    {/* Literata loads only on long-form reading pages (keeps the base bundle lean). */}
    {reading && <Font cssVariable="--ff-reading" />}

    {
      /* Structured data: site-wide Person + optional per-page schema. JSON-LD is a
       non-executable data block, so Astro's CSP does not hash it — emit verbatim.
       Escape "<" so a title containing "</script>" can't break out of the block. */
    }
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema()).replace(/</g, "\\u003c")}
    />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
        />
      )
    }

    <ClientRouter />
  </head>

  <body>
    <SkipLink label={t.actions.skipToContent} />
    <Header />
    <main id="main" class={mainClass}>
      <slot />
    </main>
    <Footer />
    <MobileTabBar />
    <MenuSheet
      client:idle
      items={menuItems}
      legal={legalItems}
      title={t.nav.menu}
      closeLabel={t.nav.close}
      legalTitle={t.footer.legal}
    />

    <SearchModal client:idle labels={t.search} locale={lang} />

    {!onLegalPage && <LegalGateSheet client:idle strings={t.gate} links={legalItems} />}

    <ReportDialog locale={lang} />

    <script>
      import "../lib/bugbuffer"; // installs the client error ring-buffer on load

      // Register the offline-fallback service worker once, after first load.
      if ("serviceWorker" in navigator) {
        const register = () => navigator.serviceWorker.register("/sw.js").catch(() => {});
        if (document.readyState === "complete") register();
        else addEventListener("load", register, { once: true });
      }
    </script>

    <script>
      // One document-level click listener routes every trigger to its island.
      // It survives View Transitions navigations.
      document.addEventListener("click", (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;
        if (target.closest("[data-menu-trigger]")) {
          document.dispatchEvent(new CustomEvent("toggle-menu"));
        } else if (target.closest("[data-search-trigger]")) {
          document.dispatchEvent(new CustomEvent("open-search"));
        }
      });

      // "/" opens search — unless the user is typing in a field or holding a modifier.
      document.addEventListener("keydown", (e) => {
        if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
        const el = e.target;
        if (
          el instanceof HTMLElement &&
          (el.isContentEditable ||
            el.tagName === "INPUT" ||
            el.tagName === "TEXTAREA" ||
            el.tagName === "SELECT")
        ) {
          return;
        }
        e.preventDefault();
        document.dispatchEvent(new CustomEvent("open-search"));
      });
    </script>
  </body>
</html>
