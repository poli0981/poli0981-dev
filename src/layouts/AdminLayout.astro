---
import "../styles/global.css";
import "../styles/admin.css";
import { Font } from "astro:assets";
import PublishBar from "../components/admin/PublishBar.svelte";

// Layout for admin.poli0981.dev (behind Cloudflare Access; middleware re-checks the JWT
// on every request). No analytics, no service worker, no Turnstile gate, noindex.
interface Props {
  title: string;
}
const { title } = Astro.props;
const email = Astro.locals.admin?.email ?? "";
const here = Astro.url.pathname;
const nav = [
  {
    href: "/admin/",
    label: "Nội dung",
    match: (p: string) => p === "/admin/" || p.startsWith("/admin/edit"),
  },
  { href: "/admin/media/", label: "Ảnh", match: (p: string) => p.startsWith("/admin/media") },
  {
    href: "/admin/gallery/",
    label: "Gallery",
    match: (p: string) => p.startsWith("/admin/gallery"),
  },
];
---

<html lang="vi" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · admin · poli0981.dev</title>
    <Font cssVariable="--ff-body" preload />
    <Font cssVariable="--ff-display" />
    <Font cssVariable="--ff-mono" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="admin">
    <header class="admin-bar">
      <a class="brand" href="/admin/">poli0981 · admin</a>
      <nav aria-label="Admin">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={item.match(here) ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <PublishBar client:only="svelte" />
      <span class="who">
        {email}
        <a href="/cdn-cgi/access/logout">Đăng xuất</a>
      </span>
    </header>
    <main class="admin-main">
      <slot />
    </main>
  </body>
</html>

<style>
  .admin-bar {
    position: sticky;
    inset-block-start: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding: 0.75rem 1.25rem;
    border-block-end: 1px solid var(--line);
    background: var(--surface);
  }
  .brand {
    font-family: var(--ff-display);
    font-weight: 700;
    color: var(--text);
  }
  nav {
    display: flex;
    gap: 1rem;
  }
  nav a {
    color: var(--muted);
  }
  nav a[aria-current="page"] {
    color: var(--accent);
  }
  .who {
    margin-inline-start: auto;
    color: var(--muted);
    font-size: var(--text-meta);
  }
  .who a {
    margin-inline-start: 0.5rem;
  }
  .admin-main {
    max-inline-size: 80rem;
    margin-inline: auto;
    padding: 1.5rem 1.25rem 4rem;
  }
</style>
