---
import BaseLayout from "./BaseLayout.astro";
import Prose from "../components/Prose.astro";
import Waveline from "../components/Waveline.svelte";
import ContentWarning from "../components/ContentWarning.astro";
import ReadingControls from "../components/ReadingControls.svelte";
import Pagination from "../components/Pagination.astro";
import type { StoryEntry } from "../lib/collections";
import { useTranslations } from "../i18n";
import type { Locale } from "../i18n/routing";
import { SITE, authorRef } from "../lib/seo";
import { ogUrl } from "../lib/og";

interface NavLink {
  href: string;
  label: string;
}
interface Props {
  entry: StoryEntry;
  locale: Locale;
  seriesHref?: string | null;
  seriesTocHref?: string | null;
  prev?: NavLink | null;
  next?: NavLink | null;
  translationHref?: string | null;
}
const {
  entry,
  locale,
  seriesHref = null,
  seriesTocHref = null,
  prev = null,
  next = null,
  translationHref = null,
} = Astro.props;
const t = useTranslations(locale);
const { title, description, series, contentWarning } = entry.data;
const hasCW = contentWarning.length > 0;

const pathname = Astro.url.pathname;
const alternates = translationHref
  ? locale === "vi"
    ? { vi: pathname, en: translationHref }
    : { en: pathname, vi: translationHref }
  : null;
const storySchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: title,
  headline: title,
  description,
  inLanguage: locale === "vi" ? "vi-VN" : "en-US",
  ...(series ? { isPartOf: { "@type": "CreativeWorkSeries", name: series } } : {}),
  ...(hasCW ? { contentRating: contentWarning.join(", ") } : {}),
  author: authorRef(),
  url: new URL(pathname, SITE.url).href,
};
---

<BaseLayout
  {title}
  {description}
  {locale}
  type="article"
  reading
  {alternates}
  jsonLd={storySchema}
  image={ogUrl("story", entry.id)}
>
  {/* Sticky reader bar. The "Aa" reading controls trigger is added in M5. */}
  <div class="reader-bar">
    <a class="back" href={seriesHref ?? seriesTocHref ?? "#"}>
      ← <span>{series ?? t.nav.stories}</span>
    </a>
    <span class="chapter-title">{title}</span>
    <ReadingControls client:idle labels={t.reader} />
  </div>

  <article id="reader-root" class="reading-column reader" data-pagefind-body>
    <header class="reader-head">
      {series && <p class="series">{series}</p>}
      <h1>{title}</h1>
    </header>

    {
      hasCW ? (
        <ContentWarning warnings={contentWarning} title={t.story.cwTitle} hint={t.story.cwHint}>
          <Prose reader>
            <slot />
          </Prose>
        </ContentWarning>
      ) : (
        <Prose reader>
          <slot />
        </Prose>
      )
    }

    <footer class="reader-foot" data-pagefind-ignore>
      <Waveline client:visible height={36} />
      <Pagination
        {prev}
        {next}
        prevText={t.post.prev}
        nextText={t.post.next}
        ariaLabel="Chapter navigation"
      />
      {
        seriesTocHref && (
          <a class="toc-link" href={seriesTocHref}>
            {t.story.seriesToc}
          </a>
        )
      }
    </footer>
  </article>
</BaseLayout>

<style>
  .reader-bar {
    position: sticky;
    inset-block-start: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem clamp(1rem, 4vw, 2rem);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-block-end: 1px solid var(--line);
    font-size: var(--text-meta);
  }
  .reader-bar .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .reader-bar .back:hover {
    color: var(--accent);
  }
  .chapter-title {
    flex: 1;
    text-align: center;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .reader-controls-slot {
    inline-size: 2.5rem;
  }

  .reading-column {
    max-inline-size: 46rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
    padding-block: clamp(2rem, 6vw, 3.5rem);
  }

  /* Text size — drives --reader-fs, inherited by the reader Prose. */
  .reader {
    --reader-fs: clamp(1.125rem, 1.05rem + 0.32vw, 1.25rem);
  }
  .reader[data-reader-size="s"] {
    --reader-fs: clamp(1rem, 0.97rem + 0.15vw, 1.0625rem);
  }
  .reader[data-reader-size="l"] {
    --reader-fs: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem);
  }

  /* Reader background — independent of the site theme. "paper" and "dark" take the
     site's light and dark palettes (global.css lists [data-reader-theme] next to
     [data-theme]); sepia is the reader's own warm palette. */
  .reader[data-reader-theme] {
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    margin-block: 1rem 2rem;
  }
  .reader[data-reader-theme="sepia"] {
    color-scheme: light;
    --bg: #f2e6cf;
    --surface: #f8efdb;
    --elevated: #fbf3e0;
    --line: #dcc9a0;
    --line-strong: #8f7a52;
    --text: #3a2f1d;
    --muted: #6b5a3d;
    --accent: #8a5a12;
    --accent-strong: #6f4808;
    --accent-contrast: #ffffff;
  }
  .reader-head {
    margin-block-end: 1.75rem;
    text-align: center;
  }
  .series {
    color: var(--muted);
    font-family: var(--ff-mono);
    font-size: var(--text-meta);
  }
  .reader-head h1 {
    margin-block-start: 0.35rem;
    font-size: var(--text-h1);
    line-height: 1.12;
  }
  .reader-foot {
    margin-block-start: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .toc-link {
    align-self: center;
    color: var(--accent);
    font-family: var(--ff-mono);
    font-size: var(--text-meta);
  }
</style>
