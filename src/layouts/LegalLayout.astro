---
import BaseLayout from "./BaseLayout.astro";
import Prose from "../components/Prose.astro";
import { useTranslations } from "../i18n";
import { legalNav, isActivePath } from "../lib/nav";
import { markLanguageHalves } from "../lib/legal-lang";
import type { Locale } from "../i18n/routing";

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  effectiveDate?: string;
}
const { title, description, locale, effectiveDate } = Astro.props;
const t = useTranslations(locale);
const links = legalNav(locale);
const pathname = Astro.url.pathname;
const effectiveLabel = locale === "vi" ? "Hiệu lực" : "Effective";
// The document holds both languages; each half gets its `lang` at build time.
const body = markLanguageHalves(await Astro.slots.render("default"));
---

<BaseLayout {title} {description} {locale}>
  <div class="legal-wrap page">
    {
      /* A navigation landmark, named apart from the footer's "Legal" nav so the two can be
         told apart in a landmark list. */
    }
    <nav class="legal-side" aria-label={t.gate.linksLabel}>
      <p class="side-title" aria-hidden="true">{t.footer.legal}</p>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isActivePath(pathname, l.href) ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <article class="legal-doc">
      <h1>{title}</h1>
      {
        effectiveDate && (
          <p class="effective">
            {effectiveLabel}: {effectiveDate}
          </p>
        )
      }
      <Prose class="legal-body">
        <Fragment set:html={body} />
      </Prose>
    </article>
  </div>
</BaseLayout>

<style>
  /* minmax(0, …): a plain `1fr` column never gets narrower than its longest unbreakable
     word, so a bare URL in the text made the whole page 4px wider than a 320px screen. */
  .legal-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding-block: clamp(2rem, 6vw, 3.5rem);
  }
  .legal-side {
    align-self: start;
  }
  .side-title {
    color: var(--muted);
    font-size: var(--text-meta);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-block-end: 0.5rem;
  }
  .legal-side ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .legal-side a {
    color: var(--muted);
    font-size: var(--text-body);
  }
  .legal-side a:hover,
  .legal-side a[aria-current="page"] {
    color: var(--accent);
  }
  /* Not by colour alone (WCAG 1.4.1). */
  .legal-side a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }
  .legal-doc h1 {
    font-size: var(--text-h1);
  }
  .effective {
    margin-block-start: 0.5rem;
    color: var(--muted);
    font-family: var(--ff-mono);
    font-size: var(--text-meta);
  }
  .legal-body {
    margin-block-start: 1.75rem;
  }

  @media (min-width: 900px) {
    .legal-wrap {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: 3rem;
    }
    .legal-side {
      position: sticky;
      inset-block-start: 5rem;
    }
    .legal-side ul {
      flex-direction: column;
    }
  }
</style>
