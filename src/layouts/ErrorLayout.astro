---
import "../styles/global.css";
import { Font } from "astro:assets";
import ReportDialog from "../components/ReportDialog.astro";
import CfBeacon from "../components/CfBeacon.astro";
import { useTranslations } from "../i18n";
import { DEFAULT_LOCALE, homePath, sectionPath, type Locale } from "../i18n/routing";

interface Props {
  title: string;
  /** Page language — `lang`, the links and the report dialog (only 404 has an English twin). */
  locale?: Locale;
  /** Show the Home / Blog / Truyện links (hidden for 429 + offline). */
  showLinks?: boolean;
  /** Show the "Báo lỗi" affordance (404 / 500 only). */
  showReport?: boolean;
  /** Reference code (500) forwarded to the report dialog. */
  ref?: string;
}
const { title, locale = DEFAULT_LOCALE, showLinks = true, showReport = false, ref } = Astro.props;
const t = useTranslations(locale);
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    {/* Theme bootstrap comes from the `themeBootstrap` integration (astro.config.mjs). */}
    <title>{title}</title>
    {/* Only the body font — no display/reading font, no islands (docs 09 §3.1). */}
    <Font cssVariable="--ff-body" preload />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <CfBeacon />
  </head>

  <body>
    <main class="err">
      <svg class="flatline" viewBox="0 0 320 24" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          {
            /* userSpaceOnUse: a flat line has a 0-tall bounding box, and WebKit drops an
            objectBoundingBox gradient on it — the line vanished on iPhone (see Waveline). */
          }
          <linearGradient
            id="err-flat"
            gradientUnits="userSpaceOnUse"
            x1="0"
            y1="0"
            x2="320"
            y2="0"
          >
            <stop offset="0%" class="l"></stop>
            <stop offset="42%" class="l"></stop>
            <stop offset="50%" class="a"></stop>
            <stop offset="58%" class="l"></stop>
            <stop offset="100%" class="l"></stop>
          </linearGradient>
        </defs>
        <line
          x1="0"
          y1="12"
          x2="320"
          y2="12"
          stroke="url(#err-flat)"
          stroke-width="1.5"
          vector-effect="non-scaling-stroke"></line>
      </svg>

      <slot />

      {
        showLinks && (
          <nav class="err-nav" aria-label={t.landmarks.errorNav}>
            <a href={homePath(locale)}>{t.nav.home}</a>
            <a href={sectionPath("blog", locale)}>{t.nav.blog}</a>
            <a href={sectionPath("stories", locale)}>{t.nav.stories}</a>
          </nav>
        )
      }

      {
        showReport && (
          <button type="button" class="err-report" data-report-trigger>
            {t.actions.reportBug}
          </button>
        )
      }
    </main>

    {showReport && <ReportDialog {locale} ref={ref} />}
  </body>
</html>

<style>
  .err {
    min-block-size: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    text-align: center;
    padding: 2rem 1.25rem;
    max-inline-size: 40rem;
    margin-inline: auto;
  }
  .flatline {
    inline-size: min(20rem, 80vw);
    block-size: 24px;
  }
  .flatline .l {
    stop-color: var(--line);
  }
  .flatline .a {
    stop-color: var(--accent);
  }
  .err-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    margin-block-start: 0.5rem;
  }
  .err-nav a {
    color: var(--accent);
    font-family: var(--ff-mono);
    font-size: var(--text-meta);
  }
  .err-nav a:hover {
    color: var(--accent-strong);
  }
  .err-report {
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font-family: var(--ff-mono);
    font-size: var(--text-meta);
    cursor: pointer;
  }
  .err-report:hover {
    color: var(--accent);
  }

  /* Shared error-content styles (used by the slotted page content). */
  :global(.err h1) {
    font-family: var(--ff-body);
    font-weight: 600;
    font-size: var(--text-h2);
    line-height: 1.15;
  }
  /* The heading again in the other language, under the main one. */
  :global(.err .echo) {
    color: var(--muted);
    font-size: var(--text-lead);
  }
  :global(.err .code) {
    font-family: var(--ff-mono);
    font-size: var(--text-meta);
    color: var(--muted);
  }
  :global(.err .ref) {
    color: var(--accent);
  }
  :global(.err .code a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
