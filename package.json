    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.6",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
