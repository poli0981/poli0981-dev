{
  "name": "poli0981-dev",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "lefthook": true,
    "fsevents": true
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/gen-og.mjs && pagefind --site dist/client && node scripts/check-csp-hashes.mjs",
    "check-csp": "node scripts/check-csp-hashes.mjs",
    "smoke": "node scripts/smoke-worker.mjs",
    "probe:ratelimit": "node scripts/probe-ratelimit.mjs",
    "test": "node --import ./tests/support/register.mjs --test \"tests/**/*.test.ts\"",
    "pretest:coverage": "node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\"",
    "test:coverage": "node --import ./tests/support/register.mjs --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-include=\"workers/widgets/src/**/*.ts\" --test-coverage-exclude=\"**/*.d.ts\" --test-coverage-exclude=\"src/lib/easter.ts\" --test-coverage-exclude=\"src/content.config.ts\" --test-coverage-lines=80 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"tests/**/*.test.ts\"",
    "gen-notices": "node scripts/gen-notices.mjs",
    "new:post": "node scripts/new-post.mjs",
    "gen-og": "node scripts/gen-og.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json && node node_modules/@typescript/native/bin/tsc -p workers/widgets/tsconfig.json",
    "types": "wrangler types --strict-vars=false",
    "types:widgets": "wrangler types --config workers/widgets/wrangler.jsonc workers/widgets/worker-configuration.d.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "deploy": "wrangler deploy",
    "strip-exif": "node scripts/strip-exif.mjs",
    "check-exif": "node scripts/check-exif.mjs",
    "check-install-scripts": "node scripts/check-install-scripts.mjs"
  },
  "overrides": {
    "fflate": "^0.7.5",
    "sharp": "$sharp",
    "miniflare": {
      "undici": "^7.30.1"
    }
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "jose": "^6.2.13",
    "marked": "^18.1.1",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-svelte": "^3.23.1",
    "exifr": "^7.1.3",
    "knip": "^6.42.1",
    "lefthook": "^2.2.2",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.0",
    "wrangler": "^4.152.0"
  }
}
