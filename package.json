  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "lefthook": true,
    "fsevents": true
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/gen-og.mjs && pagefind --site dist/client && node scripts/check-csp-hashes.mjs",
    "check-csp": "node scripts/check-csp-hashes.mjs",
    "smoke": "node scripts/smoke-worker.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "gen-notices": "node scripts/gen-notices.mjs",
    "new:post": "node scripts/new-post.mjs",
    "gen-og": "node scripts/gen-og.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "deploy": "wrangler deploy --config ./dist/server/wrangler.json",
    "strip-exif": "node scripts/strip-exif.mjs",
    "check-exif": "node scripts/check-exif.mjs"
  },
  "overrides": {
    "fflate": "^0.7.5",
    "sharp": "$sharp"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
